{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/api/index.py"
    },
    {
      "source": "/images/(.*)",
      "destination": "backend/images/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ],
  "functions": {
    "backend/api/index.py": {
      "runtime": "vercel-python@0.1.0",
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
